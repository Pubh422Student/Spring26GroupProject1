my_summary_func <- function(data_column) {
cat("Summary:\n")
print(summary(data_column))
cat("\nMean: ", mean(data_column),
"\nMedian: ", median(data_column),
"\nStd. Dev: ", sd(data_column),
"\nVariance: ", var(data_column), "\n")
}
